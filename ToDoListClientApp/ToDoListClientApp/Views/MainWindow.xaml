<Window x:Class="ToDoListClientApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="To-Do List Client" Height="400" Width="600">
    <Grid Margin="10">
        <StackPanel>
            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}" 
                     Width="400" Height="30" Margin="0 0 0 10"/>
            <Button Content="Add Item" Command="{Binding AddCommand}" Width="100"/>

            <ListView ItemsSource="{Binding Items}" Margin="0 10 0 0">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="ID" DisplayMemberBinding="{Binding Id}" Width="50"/>
                        <GridViewColumn Header="Description" DisplayMemberBinding="{Binding Description}" Width="300"/>
                        <GridViewColumn Header="Completed" Width="100">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                              Command="{Binding DataContext.ToggleStatusCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                              CommandParameter="{Binding}" />
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </StackPanel>
    </Grid>
</Window>
